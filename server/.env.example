APP_NAME=MuVi Rehab

# Local SQLite file (relative paths start from server/).
DATABASE_URL=sqlite:///../data/motionlab.db
# Hosted PostgreSQL:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE

JWT_SECRET=replace-with-a-random-64-character-string
JWT_EXPIRE_MINUTES=720

ADMIN_EMAIL=admin@motionlab.local
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=MuVi Rehab Admin

# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173

# The game settings exported by the web app. Leave empty for shared/game-specs.json in the
# repository; Docker sets /shared/game-specs.json.
GAME_SPECS_PATH=

# The measures MotionLab reports. Leave empty for shared/metrics-catalog.json; Docker sets
# /shared/metrics-catalog.json.
METRICS_CATALOG_PATH=

# The fixed safety notices of the feedback. Leave empty for shared/safety-notices.json; Docker
# sets /shared/safety-notices.json.
SAFETY_NOTICES_PATH=

# Minutes of active game play after which the games suggest finishing soon, then finishing.
SESSION_FINISH_SOON_MIN=25
SESSION_FINISH_MIN=35

# The LLM feedback module (app/feedback). "ollama" calls the local Ollama app; "mock" returns a
# canned answer (tests always use mock).
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3.5:4b
# Models compared by analysis/llm/speed_test.py and the evaluation.
LLM_MODELS_CANDIDATES=qwen3.5:4b,qwen3.5:2b,phi4-mini
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_NUM_CTX=4096
# The longest answer, in tokens.
LLM_MAX_TOKENS=700
LLM_TIMEOUT_S=60
# How long Ollama keeps the model loaded after a request.
LLM_KEEP_ALIVE=30m
# A report job's total time (all attempts); after it the template report is used.
LLM_JOB_LIMIT_S=120
# Bangla reports: direct (the model writes Bangla), translate (English, then translated)
# or template (no model). Compare them with analysis/llm/eval_bangla.py.
LLM_BN_STRATEGY=direct
# How long a report queued by the questionnaire waits for its session to end.
FEEDBACK_SESSION_END_WAIT_S=10
