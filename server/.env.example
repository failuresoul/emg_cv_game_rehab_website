APP_NAME=MuVi Rehab

# Local SQLite file (relative paths start from server/).
DATABASE_URL=sqlite:///../data/motionlab.db
# Hosted PostgreSQL:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE

JWT_SECRET=replace-with-a-random-64-character-string
JWT_EXPIRE_MINUTES=720

ADMIN_EMAIL=admin@motionlab.local
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=MuVi Rehab Admin

# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173

# The game settings exported by the web app. Leave empty for shared/game-specs.json in the
# repository; Docker sets /shared/game-specs.json.
GAME_SPECS_PATH=

# The measures MotionLab reports. Leave empty for shared/metrics-catalog.json; Docker sets
# /shared/metrics-catalog.json.
METRICS_CATALOG_PATH=

# Minutes of active game play after which the games suggest finishing soon, then finishing.
SESSION_FINISH_SOON_MIN=25
SESSION_FINISH_MIN=35
